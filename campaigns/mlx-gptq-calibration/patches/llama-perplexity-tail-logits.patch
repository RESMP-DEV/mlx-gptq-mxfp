+static int perplexity_first_scored_token(int n_ctx) {
+    const char * value = std::getenv("LLAMA_PPL_EVAL_TOKENS");
+    if (value == nullptr || value[0] == '\0') {
+        return n_ctx/2;
+    }
+
+    char * end = nullptr;
+    const long requested = std::strtol(value, &end, 10);
+    if (end == value || *end != '\0' || requested <= 0) {
+        LOG_ERR("invalid LLAMA_PPL_EVAL_TOKENS=%s; expected a positive integer\n", value);
+        return n_ctx/2;
+    }
+
+    const int evaluated = std::min<int>(requested, n_ctx - 1);
+    return n_ctx - 1 - evaluated;
+}
