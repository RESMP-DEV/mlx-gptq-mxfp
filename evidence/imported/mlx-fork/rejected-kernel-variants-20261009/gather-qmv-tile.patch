+
+  // A wider output tile reuses each loaded input element across more expert
+  // rows, which matters when the gather is bandwidth bound. Only the fast path
+  // has a tile-width instantiation, so the wide tile is a fast-path choice.
+  int results_per_simdgroup = 4;
